# Copy to backend/.env and fill in. Values shown are for the local docker compose stack.

# ── Required ─────────────────────────────────────────
# At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL. Local compose database shown; any postgres:// URL works (Neon, Supabase, ...).
DATABASE_URL=postgresql://documind:documind@localhost:5432/documind

# ── AI ───────────────────────────────────────────────
# Without it the app runs, but summaries are skipped and chat returns 503.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Optional services ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY_ID=documind
S3_SECRET_ACCESS_KEY=documind-local-secret
S3_BUCKET=documind
S3_REGION=us-east-1
# Without S3_ENDPOINT_URL, uploads are stored on disk here instead
LOCAL_STORAGE_DIR=data/uploads

# ── Ingestion and retrieval (defaults are fine) ──────
WORKER_ENABLED=true
INGEST_MAX_ATTEMPTS=3
CHUNK_TARGET_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
RERANKER_ENABLED=true
RETRIEVAL_CANDIDATES=30
ANSWER_SOURCES=5
MIN_RERANK_SCORE=-8.0

# ── HTTP ─────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=            # comma-separated; only when the frontend is served from another domain
ENABLE_API_DOCS=false    # true serves Swagger UI at /api/docs

# ── Limits ───────────────────────────────────────────
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
ACCESS_TOKEN_TTL_HOURS=24
