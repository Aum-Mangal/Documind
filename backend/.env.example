# Copy to backend/.env. With `docker compose up` the only value worth setting is GROQ_API_KEY;
# everything else has working defaults, and the database/Redis/storage URLs below are ignored
# in favour of the compose services.

# ── AI (needed for summaries, answers and graph relations) ──
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Secret key ───────────────────────────────────────
# Leave empty with Docker: one is generated on first start and kept in a volume.
# Running the API directly with uvicorn needs one (at least 32 random characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Database (only when running the API outside Docker) ──
# PostgreSQL. Local compose database shown; any postgres:// URL works.
DATABASE_URL=postgresql://documind:documind@localhost:5432/documind
# Only for a hosted database behind a transaction-mode pooler (e.g. PgBouncer): migrations need
# the direct connection, and DB_PGBOUNCER must be true. DB_NULL_POOL keeps no idle connections.
MIGRATION_DATABASE_URL=
DB_PGBOUNCER=false
DB_NULL_POOL=false

# ── Optional services ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY_ID=documind
S3_SECRET_ACCESS_KEY=documind-local-secret
S3_BUCKET=documind
S3_REGION=us-east-1
# Without S3_ENDPOINT_URL, uploads are stored on disk here instead
LOCAL_STORAGE_DIR=data/uploads

# ── Ingestion and retrieval (defaults are fine) ──────
WORKER_ENABLED=true
INGEST_MAX_ATTEMPTS=3
CHUNK_TARGET_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
RERANKER_ENABLED=true
RETRIEVAL_CANDIDATES=30
ANSWER_SOURCES=5
MIN_RERANK_SCORE=-8.0

# ── Rate limits and quotas (0 disables one) ──────────
TRUST_PROXY_HEADERS=false   # true behind a reverse proxy
SIGNUP_PER_HOUR=5
LOGIN_PER_MINUTE=20
LOGIN_PER_EMAIL_PER_15MIN=10
CHAT_PER_MINUTE=20
UPLOAD_PER_HOUR=60
DAILY_TOKEN_QUOTA=200000
MAX_DOCUMENTS_PER_USER=200
MAX_STORAGE_MB_PER_USER=500
ANSWER_CACHE_SECONDS=3600

# ── Logging and errors ───────────────────────────────
LOG_FORMAT=text             # json in production
LOG_LEVEL=INFO
SENTRY_DSN=

# ── HTTP ─────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=            # comma-separated; only when the frontend is served from another domain
ENABLE_API_DOCS=false    # true serves Swagger UI at /api/docs

# ── Limits ───────────────────────────────────────────
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
ACCESS_TOKEN_TTL_HOURS=24
